# Local development settings. Copy to .env (`cp .env.dist .env`).
#
# This file is read by Docker Compose only (variable interpolation in
# docker-compose.yml); the app gets its configuration from the container
# environment. symfony/dotenv is not installed, so .env.local is ignored.
# After changing a value, re-run `docker compose ... up -d` to recreate the
# app container.

APP_ENV=dev
APP_SECRET=dev_secret_not_for_production
APP_IMAGE=ghcr.io/steel-archer/php-dev:latest

DEFAULT_URI=http://localhost:8080

MYSQL_ROOT_PASSWORD=root_pass
MYSQL_PASSWORD=rating_pass

# Google OAuth client. Authorised redirect URI must include
# http://localhost:8080/connect/google/check
GOOGLE_CLIENT_ID=ask_product_owner_for_client_id
GOOGLE_CLIENT_SECRET=ask_product_owner_for_client_secret

# Optional. 0 hides the site-wide alpha-testing banner.
# ALPHA_TESTING_MODE=1

# Optional. Leave empty locally so dev errors are not reported to Sentry.
# SENTRY_DSN=
