# Production environment template. Copy to .env next to
# docker-compose.prod.yml on the server and fill in real values.

# Always deploy a concrete commit SHA tag, never
# :latest — otherwise there is no way to tell which build is running.
APP_IMAGE=ghcr.io/steel-archer/rating-app:REPLACE_WITH_COMMIT_SHA
IMAGE_PULL_POLICY=missing

# Public hostname and the address Let's Encrypt uses for expiry warnings.
DOMAIN=rating.example.org
ACME_EMAIL=you@example.org

# Must match DOMAIN; used for absolute URLs generated outside a web request.
DEFAULT_URI=https://rating.example.org

# Generate with: openssl rand -hex 32
APP_SECRET=REPLACE_ME

# Generate each with: openssl rand -hex 32
# Must stay URL-safe: MYSQL_PASSWORD is interpolated into DATABASE_URL, where a
# base64 "/" would truncate the host and break every database connection.
MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_PASSWORD=REPLACE_ME

# Google Cloud Console -> Credentials -> OAuth client.
# Authorised redirect URI must be https://<DOMAIN>/connect/google/check
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
