<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'maintenance.page_title'|trans }} — {{ 'site.title'|trans }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {{ importmap('app', {nonce: csp_nonce()}) }}
</head>
<body>
    <main>
        <div class="container">
            <div class="error-page">
                <div class="error-code">🔧</div>
                <div class="error-message">{{ 'maintenance.page_title'|trans }}</div>
                <p class="error-hint">{{ 'maintenance.hint'|trans }}</p>
                {% if not app.user %}
                    <a href="{{ path('auth_google_start') }}" class="error-link">{{ 'auth.login'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </main>
</body>
</html>
