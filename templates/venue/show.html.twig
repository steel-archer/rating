{% extends 'base.html.twig' %}

{% block title %}{{ venue.name }} — {{ 'nav.venues'|trans }} — {{ 'site.title'|trans }}{% endblock %}

{% block breadcrumbs %}
    <nav class="breadcrumbs"><a href="{{ path('home') }}">{{ 'nav.home'|trans }}</a><span><a href="{{ path('venue_index') }}">{{ 'nav.venues'|trans }}</a></span><span>{{ venue.name }}</span></nav>
{% endblock %}

{% block body %}
    <h1>{{ venue.name }}</h1>
    <div class="meta"><span>{{ venue.townName }}, {{ venue.countryName }}</span></div>

    {% if venue.url %}
        <div class="meta"><a href="{{ venue.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ venue.url }}</a></div>
    {% endif %}

    {% if venue.description %}
        <div class="card">
            <h2>{{ 'venue.description'|trans }}</h2>
            <p class="venue-description">{{ venue.description|linkify }}</p>
        </div>
    {% endif %}

    {% if venue.representatives is not empty %}
        <div class="card">
            <h2>{{ 'venue.representatives'|trans }}</h2>
            <ul class="representatives-list">
                {% for rep in venue.representatives %}
                    <li>{{ include('_player_link.html.twig', {playerId: rep.playerId, playerName: rep.playerName, hasUser: rep.hasUser}, with_context: false) }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if venue.tournamentCount > 0 %}
        <turbo-frame id="venue-tournaments" src="{{ path('venue_tournaments', {id: venue.id}) }}">
            <p>{{ 'common.loading_tournaments'|trans }}</p>
        </turbo-frame>
    {% endif %}
{% endblock %}
