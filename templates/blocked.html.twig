{% extends 'base.html.twig' %}

{% block title %}{{ 'block.page_title'|trans }} — {{ 'site.title'|trans }}{% endblock %}

{% block body %}
    <div class="error-page">
        <div class="error-code">🚫</div>
        <div class="error-message">{{ 'block.page_title'|trans }}</div>
        <p class="error-hint">{{ reason }}</p>
        <form action="{{ logout_path() }}" method="post" class="logout-form">
            <button type="submit" class="error-link logout-button">{{ 'auth.logout'|trans }}</button>
        </form>
    </div>
{% endblock %}
