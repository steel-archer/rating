{% extends 'base.html.twig' %}

{% block title %}{{ team.name }} — {{ 'nav.teams'|trans }} — {{ 'site.title'|trans }}{% endblock %}

{% block breadcrumbs %}
    <nav class="breadcrumbs"><a href="{{ path('home') }}">{{ 'nav.home'|trans }}</a><span><a href="{{ path('team_index') }}">{{ 'nav.teams'|trans }}</a></span><span>{{ team.name }}</span></nav>
{% endblock %}

{% block body %}
    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;">
        <h1>{{ team.name }} ({{ team.townName }})</h1>
        {% if canSubmitCaptainClaim %}
            <button type="button" class="btn btn-muted" id="captain-claim-toggle">{{ 'captain_claim.submit'|trans }}</button>
        {% endif %}
    </div>

    {% if canSubmitCaptainClaim %}
        <div id="captain-claim-form" hidden style="margin-bottom: 1.5rem;">
            <div style="margin-top: 0.75rem; display: flex; flex-direction: column; align-items: flex-end;">
                <textarea id="captain-claim-comment" placeholder="{{ 'captain_claim.comment_placeholder'|trans }}" maxlength="1000" rows="4" style="font-family: var(--font), sans-serif; font-size: 1.0625rem; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; width: 100%; max-width: 400px; resize: vertical;"></textarea>
                <div style="margin-top: 0.5rem;">
                    <button type="button" class="btn btn-primary" id="captain-claim-submit" data-team-id="{{ team.id }}">{{ 'common.send'|trans }}</button>
                </div>
                <div id="captain-claim-status" class="save-status" hidden style="margin-top: 0.5rem;"></div>
            </div>
        </div>
    {% endif %}

    {% if team.squads is not empty %}
        <div class="card">
            <h2>{{ 'team.base_squads'|trans }}</h2>
            <dl>
                {% for squad in team.squads %}
                    <dt>{{ squad.seasonName }}</dt>
                    <dd>
                        {% for player in squad.players %}
                            {{ include('_player_link.html.twig', {playerId: player.playerId, playerName: player.playerName, hasUser: player.hasUser}, with_context: false) }}{% if player.isCaptain %} <span class="captain">(к)</span>{% endif %}<br>
                        {% endfor %}
                    </dd>
                {% endfor %}
            </dl>
        </div>
    {% endif %}

    {% if team.tournamentCount > 0 %}
        <turbo-frame id="team-tournaments" src="{{ path('team_tournaments', {id: team.id}) }}">
            <p>{{ 'common.loading_tournaments'|trans }}</p>
        </turbo-frame>
    {% endif %}
{% endblock %}
